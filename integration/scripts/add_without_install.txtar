# `gale add` records the package in gale.toml but does
# not install it. lock + sync activate it.

gale-fixture recipes $WORK/recipes
gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale add hello -g --recipes=$WORK/recipes
grep 'hello' $HOME/.gale/gale.toml

! exists $HOME/.gale/current/bin/hello

exec gale lock -g --index=$WORK/index
exec gale sync -g
exists $HOME/.gale/current/bin/hello
