# A wiped fetch tree must not block remove of another
# package. Re-stage, then sync restores the missing tree.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello -g --index=$WORK/index
exec gale install hello-dep -g --index=$WORK/index
exists $HELLO_1_0_DIR/bin/hello
exists $HELLO_DEP_1_0_DIR/bin/hello-dep

rm $HELLO_1_0_DIR

exec gale remove hello-dep -g
! exists $HOME/.gale/current/bin/hello-dep

gale-fixture fetch-setup hello 1.0
exec gale sync -g
exists $HELLO_1_0_DIR/bin/hello
exists $HOME/.gale/current/bin/hello
