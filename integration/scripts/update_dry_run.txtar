# gale update --dry-run reports what would change and
# leaves the store, gale.toml, and gale.lock untouched.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello@1.0 -g --index=$WORK/index
grep 'hello = "1\.0"' $HOME/.gale/gale.toml
cp $HOME/.gale/gale.lock $WORK/before.lock

exec gale update --dry-run hello@1.1 --index=$WORK/index
stderr 'update hello'

grep 'hello = "1\.0"' $HOME/.gale/gale.toml
cmp $HOME/.gale/gale.lock $WORK/before.lock
exists $HELLO_1_0_DIR/bin/hello
