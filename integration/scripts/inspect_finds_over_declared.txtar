# `gale inspect` exits non-zero when issues are found and
# names them. hello-dep's recipe declares a runtime dep on
# hello but its binary never references hello — a classic
# over-declared-dep case.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello-dep -g --index=$WORK/index

! exec gale inspect hello-dep
stderr 'over-declared-dep'
stderr 'hello'
