# gale.toml uses a bare version. The v2 lock roots
# name@version with no revision.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello@1.0 -g --index=$WORK/index
grep 'hello = "1\.0"' $HOME/.gale/gale.toml
grep 'hello@1\.0' $HOME/.gale/gale.lock

exec gale update hello@1.1 --index=$WORK/index
grep 'hello = "1\.1"' $HOME/.gale/gale.toml
grep 'hello@1\.1' $HOME/.gale/gale.lock
