# gale.toml + gale lock, then sync activates the lock
# without rewriting it.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec sh -c 'printf "%s\n" "[packages]" "hello = \"1.0\"" > $HOME/.gale/gale.toml'
exec gale lock -g --index=$WORK/index
exists $HOME/.gale/gale.lock
cp $HOME/.gale/gale.lock $WORK/before.lock

exec gale sync -g
exists $HOME/.gale/current/bin/hello
cmp $HOME/.gale/gale.lock $WORK/before.lock

exec gale sync -g
cmp $HOME/.gale/gale.lock $WORK/before.lock
stderr 'lock unchanged'
