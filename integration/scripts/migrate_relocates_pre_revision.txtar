# A pre-revision install lives in a bare "<version>" directory, and
# migrate moves the identity into the canonical "<version>-<revision>"
# layout.
#
# No per-scope command may do this. `gale lock --refresh` declines it
# outright: other scopes' generations link the bare path, so moving
# the identity without repairing their symlinks would break a scope
# whose owner ran nothing. Design §13 makes that repair machine-wide
# migrate's business, which is why the whole store and every scope are
# enumerated before anything moves.
#
# This script covers the store half: the canonical artifact is
# installed and verified, and the bare directory is removed only
# afterwards. The symlink-following half is a unit test
# (TestRegenerateScopeFollowsIntoTheCanonicalDir), because rewinding a
# generation to a pre-revision layout from a script would assert on
# the fixture rather than on migrate.

gale-fixture recipes $WORK/recipes

exec gale install hello -g --recipes=$WORK/recipes

# Rewind the store to the layout gale wrote before revisions existed:
# a bare directory, attesting nothing.
mv $HOME/.gale/pkg/hello/1.0-1 $HOME/.gale/pkg/hello/1.0
rm $HOME/.gale/pkg/hello/1.0/.gale-provenance.toml
exists $HOME/.gale/pkg/hello/1.0/bin/hello

exec gale migrate --recipes=$WORK/recipes
stderr 'which predates revisions'

# The identity now lives where a reinstall would write it, attested,
# and the bare directory is gone.
exists $HOME/.gale/pkg/hello/1.0-1/.gale-provenance.toml
! exists $HOME/.gale/pkg/hello/1.0
