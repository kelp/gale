# gale migrate refetches an unprovenanced store directory and puts
# the verified result in its place.
#
# Refetching is the whole point. Design §13 rejected writing a record
# beside an untouched directory as the "unverified marker" under
# another name: proving the newly fetched artifact says nothing about
# whether the bytes already on disk came from it.

gale-fixture recipes $WORK/recipes

exec gale install hello -g --recipes=$WORK/recipes
exists $HOME/.gale/pkg/hello/1.0-1/.gale-provenance.toml

# A pre-upgrade install is this directory without its record.
rm $HOME/.gale/pkg/hello/1.0-1/.gale-provenance.toml
! exists $HOME/.gale/pkg/hello/1.0-1/.gale-provenance.toml

exec gale migrate --recipes=$WORK/recipes
stderr 'Migrating unprovenanced hello@1\.0-1'

# The record is back, and the binary still runs: the directory was
# replaced by a verified refetch rather than stamped in place.
exists $HOME/.gale/pkg/hello/1.0-1/.gale-provenance.toml
exec $HOME/.gale/current/bin/hello
stdout 'hello from gale integration fixture'

# A second pass has nothing to do and says so, rather than replacing
# an already attested directory for nothing.
exec gale migrate --recipes=$WORK/recipes
stderr 'already attests itself'
