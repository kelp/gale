# `gale remove` drops the package from gale.toml, the v2
# lock, and the generation. Fetch trees stay in the store.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello -g --index=$WORK/index
exists $HELLO_1_0_DIR/bin/hello
exists $HOME/.gale/current/bin/hello

exec gale remove hello -g
stderr 'Removed hello'

exists $HELLO_1_0_DIR/bin/hello
! exists $HOME/.gale/current/bin/hello
! grep 'hello = ' $HOME/.gale/gale.toml

! exec gale remove hello -g
stderr 'not in|not installed'
