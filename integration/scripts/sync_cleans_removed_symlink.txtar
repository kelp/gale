# Hand-edit gale.toml to remove a package. Sync refuses a
# stale lock. After `gale lock`, sync drops the symlink.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello -g --index=$WORK/index
exec gale install hello-dep -g --index=$WORK/index
exists $HOME/.gale/current/bin/hello
exists $HOME/.gale/current/bin/hello-dep

exec sh -c 'grep -v hello-dep $HOME/.gale/gale.toml > $WORK/new.toml && mv $WORK/new.toml $HOME/.gale/gale.toml'
! grep 'hello-dep' $HOME/.gale/gale.toml

exec sh -c 'gale sync -g; echo status=$?'
stdout 'status=4'
stderr 'orphaned hello-dep|stale|gale lock'

exec gale lock -g --index=$WORK/index
! grep 'hello-dep' $HOME/.gale/gale.lock

exec gale sync -g
! exists $HOME/.gale/current/bin/hello-dep
exists $HOME/.gale/current/bin/hello
exists $HELLO_DEP_1_0_DIR/bin/hello-dep
