# `--quiet` suppresses install's success line.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello -g --index=$WORK/index
stderr 'Installed hello'

exec gale remove hello -g
! exists $HOME/.gale/current/bin/hello

exec gale install hello -g --quiet --index=$WORK/index
! stderr 'Installed hello'
exists $HOME/.gale/current/bin/hello
