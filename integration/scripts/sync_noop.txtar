# After install, `gale sync` does not rewrite the lock
# and the binary stays usable.

gale-fixture index $WORK/index
gale-fixture fetch-setup

exec gale install hello -g --index=$WORK/index
cp $HOME/.gale/gale.lock $WORK/before.lock

exec gale sync -g
cmp $HOME/.gale/gale.lock $WORK/before.lock

exec gale sync -g
cmp $HOME/.gale/gale.lock $WORK/before.lock

exec $HOME/.gale/current/bin/hello
stdout 'hello from gale integration fixture'
